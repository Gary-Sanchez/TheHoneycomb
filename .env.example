# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# HONEYCOMB_ADMIN_PASSWORD: Optional. Admin password required for every mutating API call
# (add/edit/delete Caserits, attendance, coaching notes, import, reset, settings).
# If unset, create the admin password from Settings on first run (stored hashed in
# honeycomb-config.json). When set, this env var takes precedence over the stored hash.
# HONEYCOMB_ADMIN_PASSWORD=""

# HONEYCOMB_ALLOW_LAN: Optional. By default the server only listens on 127.0.0.1 (this machine).
# Set to "true" to bind 0.0.0.0 and expose the API to OTHER DEVICES on your network — plain HTTP,
# so only do this behind a trusted VPN/proxy.
# HONEYCOMB_ALLOW_LAN="false"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
